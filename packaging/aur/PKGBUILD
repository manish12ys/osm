# Maintainer: Omarchy Team <manishchowdary2006@gmail.com>
pkgname=osm-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Omarchy System Monitor - A TUI system monitor written in Go"
arch=('x86_64' 'aarch64')
url="https://github.com/manish12ys/osm"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
provides=('osm')
conflicts=('osm')
source=("git+https://github.com/manish12ys/osm.git")
md5sums=('SKIP')

pkgver() {
  cd "$srcdir/osm"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/osm"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
  go build -o osm .
}

package() {
  cd "$srcdir/osm"
  install -Dm755 osm "$pkgdir/usr/bin/osm"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
